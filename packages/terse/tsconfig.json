{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@src/*": ["src/*"]
    },
    "strict": true,
    "lib": ["ESNext"],
    "types": ["bun-types"],
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
